NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by /api/cron/purge-expired-data (see vercel.json) to authenticate
# Vercel's own Cron Job requests. Generate any random secret and set it as
# an env var on the Vercel project — Vercel automatically sends it as
# `Authorization: Bearer $CRON_SECRET` once it's configured.
CRON_SECRET=
