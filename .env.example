NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by /api/cron/purge-expired-data (see vercel.json) to authenticate
# Vercel's own Cron Job requests. Generate any random secret and set it as
# an env var on the Vercel project. Vercel automatically sends it as
# `Authorization: Bearer $CRON_SECRET` once it's configured.
CRON_SECRET=

# Optional: email notifications (src/lib/email.ts) for report-ready events,
# on top of the in-app notification bell. Without RESEND_API_KEY, email
# sending is skipped and nothing else about the app changes.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Read Well <notifications@yourschooldomain.org>"
# Public base URL used to build links inside those emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: makes rate limiting (src/lib/rateLimit.ts) distributed across
# serverless instances instead of per-instance in-memory. Vercel's Upstash
# integration sets both of these for you; without them, sign-in/password-
# reset/session-code attempts are still rate-limited, just per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
