NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by /api/cron/purge-expired-data (see vercel.json) to authenticate
# Vercel's own Cron Job requests. Generate any random secret and set it as
# an env var on the Vercel project. Vercel automatically sends it as
# `Authorization: Bearer $CRON_SECRET` once it's configured.
CRON_SECRET=

# Optional: email notifications (src/lib/email.ts) for report-ready events,
# on top of the in-app notification bell. Without RESEND_API_KEY, email
# sending is skipped and nothing else about the app changes.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Read Well <notifications@yourschooldomain.org>"
# Public base URL used to build links inside those emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: summaries written with AI (src/lib/aiSummaryServer.ts). A teacher
# can ask for a short plain-language summary of a child's report, which they
# edit and approve before it reaches the PDF. Needs a key from
# console.anthropic.com, and an administrator must also switch it on for the
# school (Admin -> Settings). Without the key, the feature stays hidden. No
# names or other identifying details are sent.
#
# Option 1, Claude (the default): a key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Option 2, a free or self-hosted model: any service that speaks the common
# "chat completions" format. Examples:
#   Groq (free tier):   AI_REPORT_BASE_URL=https://api.groq.com/openai/v1
#                       AI_REPORT_MODEL=openai/gpt-oss-120b
#                       (Groq retires and renames models; if you get "model not
#                       found", pick a current name from console.groq.com/docs/models.)
#   OpenRouter (free):  AI_REPORT_BASE_URL=https://openrouter.ai/api/v1
#                       AI_REPORT_MODEL=<a model whose name ends in :free>
#   Your own computer with Ollama (nothing leaves your network):
#                       AI_REPORT_BASE_URL=http://localhost:11434/v1
#                       AI_REPORT_MODEL=llama3.1:8b
# Free hosted services can keep or learn from what they receive, so read their
# terms first. Your own Ollama is the only fully private free option, but it
# must be reachable from where this app runs (not from Vercel's servers unless
# you expose it).
AI_REPORT_PROVIDER=
AI_REPORT_BASE_URL=
AI_REPORT_API_KEY=
# The model that writes them. Optional for Claude (default claude-opus-5-5);
# required for AI_REPORT_PROVIDER=openai-compatible.
AI_REPORT_MODEL=

# Optional: makes rate limiting (src/lib/rateLimit.ts) distributed across
# serverless instances instead of per-instance in-memory. Vercel's Upstash
# integration sets both of these for you; without them, sign-in/password-
# reset/session-code attempts are still rate-limited, just per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
